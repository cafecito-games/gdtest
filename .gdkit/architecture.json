{
  "version": 1,
  "minimum_gdkit_version": "0.10.0",
  "source_roots": ["addons/gdtest"],
  "exclude": [".git/**", ".godot/**", ".gdkit/**"],
  "classifications": [
    {"pattern": "addons/gdtest/gdtest.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/*_info.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/gdtest_invocation.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/gdtest_double_context.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/gdtest_double_method.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/gdtest_signal_probe.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/version.gd", "layer": "api", "feature": "runtime"},
    {"pattern": "addons/gdtest/protocol.gd", "layer": "transport", "feature": "runtime"},
    {"pattern": "addons/gdtest/worker.gd", "layer": "worker", "feature": "runtime"},
    {"pattern": "addons/gdtest/worker_case_task.gd", "layer": "worker", "feature": "runtime"},
    {"pattern": "addons/gdtest/launcher.gd", "layer": "launcher", "feature": "runtime"}
  ],
  "dependencies": [
    {"from_layers": ["api"], "to_layers": ["api"], "to_features": ["same"]},
    {"from_layers": ["transport"], "to_layers": ["api", "transport"], "to_features": ["same"]},
    {"from_layers": ["worker"], "to_layers": ["api", "transport", "worker"], "to_features": ["same"]},
    {"from_layers": ["launcher"], "to_layers": ["api", "launcher"], "to_features": ["same"]}
  ],
  "runtime_boundaries": [],
  "test_patterns": ["fixtures/**/*.gd", "examples/**/*.gd"],
  "allowlist": ".gdkit/allowlist.json",
  "unclassified": "error"
}
